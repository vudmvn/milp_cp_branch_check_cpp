{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch Gurobi",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/test_gurobi", 
      "args": [], 
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "GUROBI_HOME", "value": "/home/orlab/gurobi1301/linux64" },
        { "name": "GRB_LICENSE_FILE", "value": "/home/orlab/gurobi_license.lic" },
        { "name": "LD_LIBRARY_PATH", "value": "/home/orlab/gurobi1301/linux64/lib:${env:LD_LIBRARY_PATH}" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}